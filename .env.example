# MySQL
DB_ROOT_PASSWORD=rootpassword
DB_DATABASE=dlp_console
DB_USERNAME=dlp_user
DB_PASSWORD=dlp_password
DB_HOST=mysql
DB_PORT=3306

# Part A: 레거시 앱
LEGACY_APP_PORT=8080

# Part B: Laravel 앱
LARAVEL_APP_PORT=8000
APP_KEY=base64:GENERATE_YOUR_APP_KEY_HERE
APP_ENV=local
APP_DEBUG=true
